{
  "schema_version": 1,
  "id": "nasal-base-v1",
  "scope": "Front-visible alar/base surface relief. No nostril cavity or internal septum.",
  "sources": {
    "nih_nose": {
      "url": "https://elementsofmorphology.nih.gov/anatomy-nose.shtml",
      "accessed": "2026-10-23",
      "use": "Terminology only; no measured proportions or images copied."
    },
    "author": {
      "use": "Procedural modeling conventions; not clinical anatomy definitions."
    }
  },
  "coordinate_policy": "U is alar half-width. V uses nose-base-to-tip height above the shared central junction and philtrum reference below it. Authored defaults, not population averages.",
  "features": {
    "ala": {
      "description": "Lateral tissue surrounding the nostril.",
      "anchors": [
        "ala_left",
        "ala_right",
        "ala_left_top",
        "ala_right_top"
      ],
      "source": "nih_nose"
    },
    "columella": {
      "description": "Tissue between the nares linking tip and base.",
      "anchors": [
        "columella_low",
        "columella_mid"
      ],
      "source": "nih_nose"
    },
    "tip": {
      "description": "Junction of the lower nasal ridge and columella.",
      "anchors": [
        "nose_tip",
        "tip_left",
        "tip_right"
      ],
      "source": "nih_nose"
    },
    "alar_attachment": {
      "description": "Modeled transition between alar tissue and the face.",
      "anchors": [
        "crease_left_low",
        "crease_right_low",
        "crease_left_top",
        "crease_right_top"
      ],
      "source": "author"
    },
    "nasolabial_junction": {
      "description": "Central modeling reference shared with the oral module; legacy key nose_base.",
      "anchors": [
        "nose_base",
        "philtrum_top"
      ],
      "source": "author"
    }
  },
  "relations": [
    [
      "columella",
      "connects_to",
      "tip"
    ],
    [
      "ala",
      "blends_into",
      "alar_attachment"
    ],
    [
      "columella",
      "connects_to",
      "nasolabial_junction"
    ]
  ],
  "shared_anchors": {
    "nose_base": {
      "module": "oral-neutral-v1",
      "target": "nose_base",
      "meaning": "Central nose/upper-lip junction, not the full anatomical nasal-base line."
    }
  },
  "required_target_landmarks": [
    "ala_left",
    "ala_right",
    "nose_base",
    "nose_tip",
    "philtrum_top"
  ],
  "landmarks_uv": {
