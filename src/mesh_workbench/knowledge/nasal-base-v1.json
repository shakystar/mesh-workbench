  },
  "paths": [
    {
      "label": "Left alar volume",
      "region": "nasal_base",
      "anchors": [
        "ala_left",
        "ala_left_top",
        "ala_left_inner"
      ],
      "radius_half_width_ratio": 0.19,
      "distance_half_width_ratio": 0.035,
      "max_displacement_half_width_ratio": 0.045
    },
    {
