  "sources": {
    "thoracic_cage": {
      "url": "https://openstax.org/books/anatomy-and-physiology-2e/pages/7-4-the-thoracic-cage",
      "use": "Qualitative sternum/ribs/posterior vertebral relationship only."
    },
    "pelvis": {
      "url": "https://openstax.org/books/anatomy-and-physiology-2e/pages/8-3-the-pelvic-girdle-and-pelvis",
      "use": "Iliac crest as superior ilium border and pelvis connection to sacrum only."
    },
    "abdominal_wall": {
      "url": "https://openstax.org/books/anatomy-and-physiology-2e/pages/11-4-axial-muscles-of-the-abdominal-wall-and-thorax",
      "use": "Paired rectus, midline linea alba and lateral oblique relationships only."
    },
    "scapula": {
      "url": "https://openstax.org/books/anatomy-and-physiology-2e/pages/8-1-the-pectoral-girdle",
      "use": "Posterior scapular plane, medial border, inferior angle and superior spine relationships only."
    }
  },
  "relationships": [
    {
      "region": "thoracic cage",
      "relation": "anterior sternum and posterior thoracic vertebrae connected by ribs",
      "source": "thoracic_cage"
    },
    {
      "region": "pelvis",
      "relation": "ilium superior margin forms iliac crest; hip bones articulate with sacrum",
      "source": "pelvis"
    },
    {
      "region": "abdomen",
      "relation": "paired rectus lies beside the anterior midline; obliques occupy the lateral wall",
      "source": "abdominal_wall"
    },
    {
      "region": "posterior shoulder",
      "relation": "scapula has a medial border, inferior angle and upper posterior spine extending laterally",
      "source": "scapula"
    }
  ],
  "coordinate_policy": "Authored U scales with registered half width. V=1 is sternum height, V=0 waist, V=-1 pelvis. Skin probes do not locate bone or muscle insertions. All depths are authored increments, not population measurements.",
